SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Secret, server-only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev-seed credentials (gitignored .env.local). NEVER point SEED_DEV at production.
SEED_DEV=0
SEED_CUSTOMER_EMAIL=customer.test@example.com
SEED_CUSTOMER_PASSWORD=change-me
SEED_ADMIN_EMAIL=admin.test@example.com
SEED_ADMIN_PASSWORD=change-me
